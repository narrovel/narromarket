# Bot token from @BotFather
BOT_TOKEN=

# App credentials from my.telegram.org
API_ID=
API_HASH=

# Comma separated Telegram IDs with full access; the owner role cannot be revoked from the bot
OWNER_IDS=

# Runtime directories. Keep these outside the source tree on a hardened deployment.
DATA_DIR=data
DATABASE_PATH=data/narromarket.db
LOGS_DIR=logs

# Telethon session file name, stored inside DATA_DIR unless this is an absolute path
SESSION_NAME=narromarket

# Timezone used for dates shown to users and for scheduled checks
TIMEZONE=Europe/Moscow

# How long a Telegram Stars invoice stays payable (1 to 10080 minutes)
INVOICE_TTL_MINUTES=60

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# How long a bank transfer stays open waiting for a receipt (1 to 720 hours)
RECEIPT_TTL_HOURS=48

# How long a receipt may sit unreviewed before staff are pinged about it (1 to 2160 hours)
REVIEW_STALE_HOURS=72

# How long screen view events are kept before the daily job prunes them (1 to 3650 days)
EVENT_RETENTION_DAYS=90

# How long a receipt is kept after its order closed (1 to 3650 days)
RECEIPT_RETENTION_DAYS=180
